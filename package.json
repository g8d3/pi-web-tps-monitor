{
  "name": "pi-web-tps-monitor",
  "description": "Live tokens/sec, TTFT, per-turn step timing and per-tool costs for Pi + PI WEB",
  "version": "0.8.7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g8d3/pi-web-tps-monitor.git"
  },
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["dist", "src", "test"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@jmfederico/pi-web": "1.202610.3",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./dist/companion.js"]
  },
  "piWeb": {
    "plugins": [
      {
        "id": "tps-monitor",
        "browserRoot": "dist/browser",
        "module": "dist/browser/index.js",
        "serverModule": "dist/server.js",
        "machineSpecific": true,
        "defaultEnabled": true
      }
    ]
  }
}
